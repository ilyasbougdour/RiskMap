<Application x:Class="RiskMap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RiskMap.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:RiskLevelToBrushConverter x:Key="LevelToBrush" />
        <local:RiskLevelToTextConverter x:Key="LevelToText" />
        <local:InfoStateToTextConverter x:Key="StateToText" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <!-- Tuiles du tableau de bord -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#F5F7F8" />
            <Setter Property="BorderBrush" Value="#CFD8DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#546E7A" />
        </Style>
    </Application.Resources>
</Application>
