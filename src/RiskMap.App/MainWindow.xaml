<Window x:Class="RiskMap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RiskMap.App"
        Title="RiskMap" Width="1250" Height="780" WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- Barre du haut : cible, choix des modules réels, actions -->
        <Border DockPanel.Dock="Top" Background="#ECEFF1" Padding="10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Réseau :" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="TargetBox" Width="150" Text="192.168.56.0/24" VerticalContentAlignment="Center" />

                <TextBlock Text="Modules réels :" VerticalAlignment="Center" Margin="20,0,6,0" />
                <CheckBox x:Name="RealDiscovery" Content="Découverte" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="RealScanner" Content="Scanner" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="RealAnalysis" Content="Analyse" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="Sans case cochée, tout tourne sur les données d'exemple." />

                <Button x:Name="ScanButton" Content="Lancer le scan" Padding="12,4" Margin="14,0,0,0" Click="Scan_Click" />
                <Button x:Name="CancelButton" Content="Arrêter" Padding="12,4" Margin="6,0,0,0" IsEnabled="False" Click="Cancel_Click" />
                <Button Content="Ouvrir…" Padding="12,4" Margin="20,0,0,0" Click="Open_Click" />
                <Button Content="Enregistrer…" Padding="12,4" Margin="6,0,0,0" Click="Save_Click" />
            </WrapPanel>
        </Border>

        <!-- Barre du bas : progression -->
        <Border DockPanel.Dock="Bottom" Background="#ECEFF1" Padding="10,4">
            <DockPanel>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="160" Height="12" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="Prêt. Sans module réel coché, le scan utilise les données d'exemple." />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des machines -->
            <DataGrid x:Name="HostsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionChanged="HostsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Adresse IP" Binding="{Binding IpAddress}" />
                    <DataGridTextColumn Header="Nom" Binding="{Binding Hostname}" />
                    <DataGridTextColumn Header="Système" Binding="{Binding Os.Name}" Width="*" />
                    <DataGridTextColumn Header="Score" Binding="{Binding Risk.Score}" />
                    <DataGridTemplateColumn Header="Niveau">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Risk.Level, Converter={StaticResource LevelToBrush}}"
                                        CornerRadius="3" Padding="6,1" Margin="2">
                                    <TextBlock Text="{Binding Risk.Level, Converter={StaticResource LevelToText}}" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CFD8DC" />

            <TabControl x:Name="Tabs" Grid.Column="2">
                <TabItem x:Name="DashboardTab" Header="Tableau de bord">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <TextBlock x:Name="NoResultText" Text="Lancez un scan ou ouvrez un résultat pour voir le tableau de bord." Foreground="Gray" />

                            <StackPanel x:Name="DashboardContent" Visibility="Collapsed">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Target}" />
                                <TextBlock Foreground="Gray" Text="{Binding Period}" />

                                <!-- Chiffres clés -->
                                <UniformGrid Columns="3" Margin="0,14,0,0">
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TileNumber}" Text="{Binding HostCount}" />
                                            <TextBlock Style="{StaticResource TileLabel}" Text="machines actives" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TileNumber}" Text="{Binding OpenPortCount}" />
                                            <TextBlock Style="{StaticResource TileLabel}" Text="ports ouverts" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tile}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TileNumber}" Text="{Binding CveCount}" />
                                            <TextBlock Style="{StaticResource TileLabel}">
                                                <Run Text="CVE potentielles, dont " /><Run Text="{Binding CriticalCveCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" critique(s)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Machines par niveau de risque -->
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Machines par niveau de risque" />
                                <ItemsControl ItemsSource="{Binding Levels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Color}" CornerRadius="4" Padding="12,8" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Count}" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding Label}" Foreground="White" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Machines les plus à risque : clic = détail -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Machines à traiter en priorité" />
                                        <ItemsControl ItemsSource="{Binding TopHosts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="TopHost_Click" Tag="{Binding}" HorizontalContentAlignment="Stretch"
                                                            Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#ECEFF1" Padding="4,6" Cursor="Hand">
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Background="{Binding Risk.Level, Converter={StaticResource LevelToBrush}}"
                                                                    CornerRadius="3" Padding="8,1" VerticalAlignment="Center">
                                                                <TextBlock Foreground="White">
                                                                    <Run Text="{Binding Risk.Level, Converter={StaticResource LevelToText}, Mode=OneWay}" />
                                                                    <Run Text=" · " /><Run Text="{Binding Risk.Score, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock>
                                                                <Run Text="{Binding IpAddress, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="  " /><Run Text="{Binding Os.Name, Mode=OneWay, TargetNullValue='système non déterminé'}" Foreground="Gray" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Ports les plus fréquents -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ports les plus ouverts" />
                                        <ItemsControl ItemsSource="{Binding TopPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3">
                                                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding Count, StringFormat='{}{0} machine(s)'}" />
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,18,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding UnknownVersionCount, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="service(s) sans version identifiée (masquée ou non déterminée) : leurs vulnérabilités ne peuvent pas être recherchées, le risque réel peut être plus élevé." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Carte du réseau">
                    <local:NetworkMapControl x:Name="Map" HostSelected="Map_HostSelected" />
                </TabItem>

                <TabItem x:Name="DetailTab" Header="Détail de la machine">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel" Margin="16">
                            <TextBlock x:Name="NoSelectionText" Text="Sélectionnez une machine dans la liste ou sur la carte." Foreground="Gray" />

                            <StackPanel x:Name="DetailContent" Visibility="Collapsed">
                                <WrapPanel>
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding IpAddress}" />
                                    <TextBlock FontSize="22" Foreground="Gray" Margin="10,0,0,0" Text="{Binding Hostname}" />
                                    <Border Background="{Binding Risk.Level, Converter={StaticResource LevelToBrush}}"
                                            CornerRadius="4" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Foreground="White" FontWeight="SemiBold">
                                            <Run Text="{Binding Risk.Level, Converter={StaticResource LevelToText}, Mode=OneWay}" />
                                            <Run Text=" · score " /><Run Text="{Binding Risk.Score, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </WrapPanel>

                                <TextBlock Margin="0,10,0,0">
                                    <Run Text="Système : " FontWeight="SemiBold" />
                                    <Run Text="{Binding Os.Name, Mode=OneWay, TargetNullValue='non déterminé'}" />
                                    <Run Text=" (confiance " /><Run Text="{Binding Os.Confidence, Mode=OneWay}" /><Run Text=" %)" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Os.Clues}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#ECEFF1" CornerRadius="3" Padding="6,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,6,0,0">
                                    <Run Text="MAC : " FontWeight="SemiBold" />
                                    <Run Text="{Binding MacAddress, Mode=OneWay, TargetNullValue='inconnue'}" />
                                    <Run Text="   Fabricant : " FontWeight="SemiBold" />
                                    <Run Text="{Binding Vendor, Mode=OneWay, TargetNullValue='inconnu'}" />
                                    <Run Text="   TTL : " FontWeight="SemiBold" />
                                    <Run Text="{Binding Ttl, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Services" />
                                <DataGrid ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" />
                                        <DataGridTextColumn Header="Service" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="Bannière brute" Binding="{Binding RawBanner}" Width="*" />
                                        <DataGridTextColumn Header="Logiciel" Binding="{Binding Product}" />
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" />
                                        <DataGridTextColumn Header="État de la version" Binding="{Binding VersionState, Converter={StaticResource StateToText}}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Vulnérabilités potentielles (CVE)" />
                                <DataGrid x:Name="CveGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CVE" Binding="{Binding CveId}" />
                                        <DataGridTextColumn Header="CVSS" Binding="{Binding CvssScore}" />
                                        <DataGridTextColumn Header="Gravité" Binding="{Binding Severity}" />
                                        <DataGridTextColumn Header="Logiciel" Binding="{Binding Software}" />
                                        <DataGridTemplateColumn Header="Description" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Calcul du score" />
                                <ItemsControl ItemsSource="{Binding Risk.Factors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Width="40" FontWeight="SemiBold" Text="{Binding Points, StringFormat='+{0}'}" />
                                                <TextBlock Text="{Binding Reason}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource SectionTitle}" Text="Synthèse IA" />
                                <Border Background="#F3F6FB" BorderBrush="#D6DEEB" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <TextBlock Text="{Binding AiSummary, TargetNullValue='Pas encore de synthèse.'}" TextWrapping="Wrap" LineHeight="20" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
